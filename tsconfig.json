{
  "compilerOptions": {
    "lib": [
      "ES2021"
    ],
    "outDir": "dist",
    "sourceMap": true,
    "target": "es6",
    "module": "commonjs",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": false,
    "allowJs": true,
    "allowSyntheticDefaultImports": false,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "./src/**/test",
    "./**/*.test.ts",
    "./src/**/demo"
  ],
  "include": [
    "./src/**/*"
  ]
}