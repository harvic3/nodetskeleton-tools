{
  "compilerOptions": {
    "lib": ["ES2020"],
    "outDir": "lib",
    "sourceMap": true,
    "target": "es6",
    "module": "commonjs",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  },
  "exclude": ["./src/**/test/", "./**/*.test.ts"],
  "include": ["./src/**/*"]
}
