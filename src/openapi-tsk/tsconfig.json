{
  "compilerOptions": {
    "lib": [
      "ES2021"
    ],
    "outDir": "lib",
    "sourceMap": true,
    "esModuleInterop": true,
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": false,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "strict": true
  },
  "exclude": [
    "./src/**/test/",
    "./**/*.test.ts"
  ],
  "include": [
    "./src/**/*"
  ]
}