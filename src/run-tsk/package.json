{
  "name": "run-tsk",
  "version": "1.1.0",
  "description": "Tool to install, initialize and interact with NodeTSKeleton project",
  "repository": {
    "type": "git",
    "url": "https://github.com/harvic3/nodetskeleton-tools"
  },
  "keywords": [
    "cli",
    "run",
    "tskeleton",
    "work flow",
    "clean architecture",
    "design patterns",
    "tool"
  ],
  "author": "Vickodev<harvic3@proton.me>",
  "license": "BSD 3-Clause",
  "homepage": "https://github.com/harvic3/nodetskeleton-tools/blob/master/src/run-tsk/README.md",
  "bugs": {
    "url": "https://github.com/harvic3/nodetskeleton-tools/issues"
  },
  "directories": {
    "lib": "lib"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "rm -rf lib/* && tsc --sourceMap false && shx cp src/**/*.sh lib/",
    "build-map": "rm -rf lib/* && tsc",
    "upload": "npm run build && npm publish"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "shx": "^0.3.4",
    "typescript": "^5.6.2"
  },
  "bin": {
    "run-tsk": "lib/index.js"
  }
}