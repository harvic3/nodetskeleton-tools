{
  "name": "tskeleton-tools",
  "version": "1.0.0",
  "description": "tools for nodetskeleton template",
  "scripts": {
    "test": "npm run build && jest --coverage --collectCoverageFrom=src/**",
    "build": "rm -rf dist/* && tsc --sourceMap false",
    "lint": "tsc --noEmit && eslint \"**/*.{js,ts}\" --quiet --fix",
    "pretty-quick": "pretty-quick",
    "pretty-check": "pretty-quick --check",
    "pre-commit": "npm run lint && npm run pretty-quick --staged && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harvic3/nodetskeleton-tools.git"
  },
  "keywords": [
    "nodejs",
    "tskeleton",
    "tools",
    "clean architecture",
    "work flow"
  ],
  "author": "Vickodev<harvic3@ingenieros.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/harvic3/nodetskeleton-tools/issues"
  },
  "homepage": "https://github.com/harvic3/nodetskeleton-tools#readme",
  "devDependencies": {
    "@types/jest": "^26.0.20",
    "@types/node": "^14.14.20",
    "@types/node-fetch": "^2.5.7",
    "@typescript-eslint/eslint-plugin": "^3.10.1",
    "@typescript-eslint/parser": "^3.10.1",
    "eslint": "^7.17.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-prettier": "^3.3.1",
    "husky": "^4.3.7",
    "jest": "^26.6.3",
    "jest-fetch-mock": "^3.0.3",
    "jest-mock-extended": "^1.0.10",
    "lerna": "^3.22.1",
    "prettier": "^2.2.1",
    "pretty-quick": "^2.0.2",
    "ts-jest": "^26.4.4",
    "typescript": "^3.9.7"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run pre-commit"
    }
  }
}
